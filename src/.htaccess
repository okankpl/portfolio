# Apache configuration for the Angular build (copied to the web root by "ng build").
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always use HTTPS (the contact form must be transmitted encrypted).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Serve existing files (assets, sendMail.php, ...) directly.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Let Angular handle all other paths such as /imprint and /privacypolicy.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Browsers must revalidate index.html (and the old language files), so a new upload is visible immediately.
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Build files contain a content hash in their name and can be cached for a long time.
  <FilesMatch "-[A-Z0-9]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
